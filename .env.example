# Скопируй в .env. Ключи не отправляй в Telegram или чат с помощником.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Для первого запуска поставь true, получи ID через /whoami, останови бота.
# После заполнения ID верни false.
SETUP_MODE=false
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
TIMEZONE=Europe/Moscow
